# Variables que el Compose exige para levantar la etapa 02-separacion.
#
# Copia este archivo como `.env` en la raíz del repositorio y cambia los
# valores. El `.env` no se sube al repositorio.

# Secreto con el que `identidad` firma los tokens y con el que el gateway y
# `envios` los validan. Debe ser el mismo en los tres: el Compose lo reparte.
JWT_SECRETO=cambia-este-secreto-por-uno-largo-y-al-azar

# Contraseña de las cuentas de alumno de la siembra (alumno1 a alumno5).
# El botón "usar demo" del front escribe `distrinubs`.
SIEMBRA_CONTRASENA_DEMO=distrinubs

# Contraseña de `admin` y `organizador1`. Debe ser distinta de la de demo.
SIEMBRA_CONTRASENA_ADMIN=cambia-esta-clave-de-administracion

# Opcionales, con su valor por omisión:
# ENTRADA_PUERTO=8080          Puerto de la entrada (nginx) en esta computadora.
# DB_PUERTO_LOCAL=5432         Puerto de PostgreSQL en esta computadora.
# EUREKA_PUERTO_LOCAL=8761     Puerto del directorio en esta computadora.
# RABBITMQ_PUERTO_LOCAL=15672  Puerto de la consola de RabbitMQ en esta computadora.
# EVALUACION_WORKERS=2         Consumidores por contenedor de `evaluacion`.
# SIEMBRA_CUENTAS_CARGA=0      Cuentas extra para la prueba de carga.
